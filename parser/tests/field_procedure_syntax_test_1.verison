(u32)const MAX_PLAYERS : 100
(u32)const MAX_INVENTORY : 250
(f32)const MOVEMENT_SPEED : 4.5
(bool)const DEBUG_MODE : false
(String)var playerName : "RELAY_OPERATOR"
(String)var currentZone : "SECTOR_07"
(i32)var playerHealth : 100
(i32)var playerEnergy : 75
(i32)var playerCredits : 500
(bool)var playerAlive : true
(bool)var inventoryFull : false
([i32;4])var inventory : [10, 20, 30, 40]

(i32)proc: calculateDamage(baseDamage i32, multiplier i32):
    return baseDamage * multiplier

(i32)proc: calculateRemainingHealth(currentHealth i32, damage i32):
    
    (i32)var remainingHealth : currentHealth - damage

    if : (remainingHealth < 0)
        (remainingHealth = 0
        return remainingHealth)

(bool)proc: validatePlayer(
        health i32,
        energy i32,
        credits i32
    ):
    
    return (
        health > 0 &&
        energy > 0 &&
        credits >= 0
    )

(i32)proc: calculateReward(baseReward i32, playerLevel i32):
    (i32)var reward : baseReward

    if : (
        playerLevel >= 10 &&
        playerLevel < 20
    )
        reward *= 2
    elif : (playerLevel >= 20)
        reward *= 3
    else :
        reward += 5

    playerHealth = 100
    playerEnergy = 75
    playerCredits = 500

    if : (validatePlayer(playerHealth, playerEnergy, playerCredits))
        playerAlive = true
        currentZone = "SECTOR_01"
    else :
        playerAlive = false

    while : (playerAlive && playerHealth > 0)

        playerHealth -= calculateDamage(5, 1)

        if : (playerHealth <= 50)
            playerEnergy -= 10

        elif : (playerHealth <= 20)
            playerEnergy -= 25

        if : (playerHealth <= 0)
            playerAlive = false
            break

    for : (i32 item, i in 0.<4)

        if : (inventory[i] > 0)
            playerCredits += inventory[i]
        else :
            inventoryFull = false

    nif : (playerHealth < 80), (playerHealth < 40), (playerHealth < 10)

        0*
            playerEnergy -= 5

        1*
            playerEnergy -= 15
            relayStatus = "WARNING"

        2*
            playerAlive = false
            relayStatus = "CRITICAL"

    (i32)var processedNodes : 0

    nfor : (i32 sector in 0.<3), (i32 node in 0.<4)

        0*
            processedNodes += 1

        1*
            if : (node % 2 is 0)
                playerCredits += 10
            else :
                playerCredits += 5

    if : (playerAlive && playerHealth > 0)
        relayStatus = "OPERATIONAL"
    else :
        relayStatus = "OFFLINE"