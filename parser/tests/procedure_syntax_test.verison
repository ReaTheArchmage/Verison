(&str)proc : getReturnPrize(tier &str)  
    ([&str;3])var prize : {
        "Scrap",
        "proc",
        "Ore"}

    if   : (
        tier == "Common")
        return prize[0]
    elif : (
        tier == "Rare")
        return prize[1]
    elif : (
        tier == "Epic")
    elif : (
        tier == "Proc proc")
        return prize[2]
    else :
        return tier